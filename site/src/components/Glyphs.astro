---
// One sprite of reusable glyphs, referenced by <use href="#stamp"> and friends.
// Inline rather than an external SVG file so the page still makes zero requests
// it does not need.
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="stamp" viewBox="0 0 40 40">
    <circle cx="20" cy="20" r="15" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <circle cx="20" cy="20" r="11.5" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 2.4"/>
    <path d="M20 11l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4-3.9-3.8 5.4-.8z" fill="currentColor"/>
  </symbol>
  <symbol id="check" viewBox="0 0 20 20"><path d="M4 10.5l3.5 3.5L16 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="x" viewBox="0 0 20 20"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
</svg>
