---
// The site footer. "Documentation" used to point at the GitHub readme because
// there was nowhere else to send people; it now points at the docs section.
---

<footer>
  <div class="wrap">
    <div class="foot">
      <a class="brand" href="/">
        <span class="seal"><svg viewBox="0 0 40 40" style="color:var(--stamp)"><use href="#stamp"/></svg></span>
        Kuraki
      </a>
      <div class="foot-links">
        <div class="foot-col">
          <b>Product</b>
          <a href="/#features">Features</a>
          <a href="/#how">How it works</a>
          <a href="/#own">Own your originals</a>
          <a href="/download">Download</a>
        </div>
        <div class="foot-col">
          <b>Documentation</b>
          <a href="/docs">All docs</a>
          <a href="/docs/install">Install</a>
          <a href="/docs/migrate">Migrate a library</a>
          <a href="/docs/configuration">Configuration</a>
        </div>
        <div class="foot-col">
          <b>Project</b>
          <a href="https://github.com/kuraki-app/kuraki" rel="noopener">GitHub</a>
          <a href="/changelog">Changelog</a>
          <a href="https://www.gnu.org/licenses/agpl-3.0.html" rel="noopener">AGPL-3.0 license</a>
        </div>
      </div>
    </div>
    <p class="foot-note">Kuraki — self-hosted photo &amp; video backup · single-owner · AGPL-3.0 · Import support is broader than browser preview; unsupported originals always stay downloadable.</p>
  </div>
</footer>
