---
// The page shell: head, SEO, fonts, nav, footer. Previously duplicated inside
// one hand-written index.html, which is exactly what made a second page
// expensive enough not to exist.
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Glyphs from '../components/Glyphs.astro';

interface Props {
  title: string;
  description: string;
  /** Overrides the OG title where the page title is too literal for a card. */
  ogTitle?: string;
  /** Marketing pages use the in-page anchor nav; docs pages do not. */
  anchorNav?: boolean;
}

const { title, description, ogTitle, anchorNav = false } = Astro.props;

// Derived from `site` in astro.config.mjs — never hardcoded per page, which is
// how the old page ended up declaring an unregistered domain as canonical.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kuraki" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2efe8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131108" />

    <!-- Favicon: the oxblood stamp, inline so it costs no request. -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23191612'/%3E%3Ccircle cx='16' cy='16' r='8.5' fill='none' stroke='%238c3a2b' stroke-width='2.4'/%3E%3Cpath d='M16 9.5l1.9 3.9 4.3.6-3.1 3 .7 4.3-3.8-2-3.8 2 .7-4.3-3.1-3 4.3-.6z' fill='%238c3a2b'/%3E%3C/svg%3E"
    />

    <!-- Fonts are served from this origin, not fonts.googleapis.com.
         A page whose argument is "your photos should not live on someone else's
         computer" should not make a third-party request to render its own
         headline. These are the same @fontsource-variable files the web client
         vendors, so the site and the app render identically. Preloaded because
         they are the only render-blocking resources left. -->
    <link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Kuraki',
        applicationCategory: 'MultimediaApplication',
        operatingSystem: 'Linux, Docker, macOS, Windows',
        description:
          'Open-source, self-hosted photo and video backup with a Google-Photos-style library. Your originals stay intact on your own server in a readable folder layout, with zero lock-in.',
        license: 'https://www.gnu.org/licenses/agpl-3.0.html',
        sameAs: ['https://github.com/kuraki-app/kuraki'],
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      })}
    />
  </head>
  <body id="top">
    <Glyphs />
    <Nav {anchorNav} />
    <slot />
    <Footer />

    <script is:inline>
      // Nav hairline on scroll
      var nav = document.getElementById('nav');
      var onScroll = function () {
        nav.classList.toggle('scrolled', window.scrollY > 8);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Scroll reveal (respects reduced motion)
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        document.querySelectorAll('.rise').forEach(function (el) {
          io.observe(el);
        });
      } else {
        document.querySelectorAll('.rise').forEach(function (el) {
          el.classList.add('in');
        });
      }
    </script>
  </body>
</html>
