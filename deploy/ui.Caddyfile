# In-container UI server (baked into the Kuraki image, NOT the HTTPS reverse
# proxy in deploy/Caddyfile). Serves the built SvelteKit SPA on :8080 as its own
# origin, and proxies the server-owned paths to the Go API on :3000 so the UI
# talks to the backend from a single browser origin — the same split the Vite
# dev server uses in scripts/dev.sh (/api, /healthz, /metrics).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode gzip

	# `handle` blocks are ordered and mutually exclusive, so the API paths are
	# proxied to the Go server BEFORE the SPA's try_files fallback can rewrite
	# them to /index.html. (With bare `try_files` + `reverse_proxy`, Caddy runs
	# the rewrite first and the proxy never sees /api/*.)
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:3000
	}
	handle /metrics {
		reverse_proxy 127.0.0.1:3000
	}
	# App downloads (the Android APK) are served by the Go server.
	handle /download/* {
		reverse_proxy 127.0.0.1:3000
	}

	# Everything else is the static SvelteKit SPA; fall back to index.html so
	# client-side routes resolve (adapter-static fallback).
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
